<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', fontFamily: '雅黑, Arial', padding: 60, flexDirection: 'column', position: 'relative' }}>
  <Box style={{ height: 52, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
      <Box style={{ width: 32, height: 32, borderRadius: 8, background: '#2563EB', justifyContent: 'center', alignItems: 'center' }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>11</Text>
      </Box>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E293B', lineHeight: 1.2 }}>收起、退出、快捷键</Text>
    </Box>
    <Text style={{ fontSize: 14, color: '#94A3B8' }}>窗口与按键</Text>
  </Box>
  <Box style={{ height: 1, background: '#E2E8F0', marginTop: 12, marginBottom: 28 }} />

  <Box style={{ height: 507, flexDirection: 'column' }}>
    <Box style={{ height: 340, flexDirection: 'row', gap: 20 }}>
      <Box style={{ width: 340, height: 340, background: '#EFF6FF', borderRadius: 8, padding: 24, flexDirection: 'column', justifyContent: 'space-between' }}>
        <Box style={{ width: 36, height: 36, borderRadius: 8, background: '#2563EB', justifyContent: 'center', alignItems: 'center' }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>×</Text>
        </Box>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E293B' }}>收起面板</Text>
        <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.55 }}>点右上角 × 或按 Esc，只是隐藏面板。桌宠还在、上传还在跑。</Text>
        <Box style={{ height: 44, background: '#FFFFFF', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
          <Text style={{ fontSize: 16, color: '#64748B' }}>不是退出，也不是最小化到托盘</Text>
        </Box>
      </Box>

      <Box style={{ width: 400, height: 340, background: '#F8FAFC', borderRadius: 8, padding: 24, flexDirection: 'column', justifyContent: 'space-between' }}>
        <Box style={{ width: 36, height: 36, borderRadius: 8, background: '#2563EB', justifyContent: 'center', alignItems: 'center' }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>⋯</Text>
        </Box>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E293B' }}>右上角「更多」菜单</Text>
        <Box style={{ flexDirection: 'column', gap: 10 }}>
          <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5 }}>存入资料…　打开网页端</Text>
          <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5 }}>退出登录　清空本机登录信息</Text>
          <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#2563EB', lineHeight: 1.5 }}>退出应用　真正结束程序</Text>
        </Box>
        <Box style={{ height: 44, background: '#FFFFFF', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
          <Text style={{ fontSize: 16, color: '#64748B' }}>右键桌宠只是切换面板显隐，不弹菜单</Text>
        </Box>
      </Box>

      <Box style={{ width: 380, height: 340, border: '1px solid #E2E8F0', borderRadius: 8, padding: 24, flexDirection: 'column', justifyContent: 'space-between' }}>
        <Box style={{ width: 36, height: 36, borderRadius: 8, background: '#06B6D4', justifyContent: 'center', alignItems: 'center' }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>⌨</Text>
        </Box>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E293B' }}>实际可用的按键</Text>
        <Box style={{ flexDirection: 'column', gap: 10 }}>
          <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5 }}>Enter 发送　·　Shift + Enter 换行</Text>
          <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5 }}>↑ / ↓ 在知识库下拉里选择</Text>
          <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5 }}>会话重命名：Enter 提交 / Esc 取消</Text>
        </Box>
        <Box style={{ height: 44, background: '#F8FAFC', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
          <Text style={{ fontSize: 16, color: '#64748B' }}>窗口还能拖动，最小 480×520</Text>
        </Box>
      </Box>
    </Box>

    <Box style={{ height: 60, marginTop: 24, flexDirection: 'row', alignItems: 'center', gap: 16, borderBottom: '1px solid #E2E8F0' }}>
      <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#2563EB', width: 150 }}>Esc 的层级</Text>
      <Text style={{ fontSize: 18, color: '#475569' }}>先关文字弹窗 → 再关存入面板 / 知识库下拉 → 最后隐藏整个面板</Text>
    </Box>

    <Box style={{ height: 63, marginTop: 20, background: '#1E293B', borderRadius: 8, padding: '0px 24px', flexDirection: 'row', alignItems: 'center' }}>
      <Box style={{ width: 6, height: 36, background: '#F59E0B', borderRadius: 8 }} />
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF', marginLeft: 20 }}>没有系统托盘；想彻底结束程序，必须用「⋯ → 退出应用」</Text>
    </Box>
  </Box>

  <Box style={{ position: 'absolute', left: 0, right: 0, bottom: 30, padding: '0px 60px', flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#94A3B8' }}>知识小助 · 桌宠使用说明</Text>
    <Text style={{ fontSize: 14, color: '#94A3B8' }}>11 / 14</Text>
  </Box>
</Slide>
