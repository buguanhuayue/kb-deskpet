<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', fontFamily: '雅黑, Arial', padding: 60, flexDirection: 'column', position: 'relative' }}>
  <Box style={{ height: 52, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
      <Box style={{ width: 32, height: 32, borderRadius: 8, background: '#2563EB', justifyContent: 'center', alignItems: 'center' }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>02</Text>
      </Box>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E293B', lineHeight: 1.2 }}>六步走完全程</Text>
    </Box>
    <Text style={{ fontSize: 14, color: '#94A3B8' }}>上手路径</Text>
  </Box>
  <Box style={{ height: 1, background: '#E2E8F0', marginTop: 12, marginBottom: 28 }} />

  <Box style={{ height: 507, flexDirection: 'column' }}>
    <Box style={{ height: 230, flexDirection: 'row', alignItems: 'center' }}>
      <Box style={{ width: 162, height: 220, background: '#F8FAFC', borderRadius: 8, border: '1px solid #E2E8F0', padding: 16, flexDirection: 'column' }}>
        <Box style={{ width: 28, height: 28, borderRadius: 8, background: '#2563EB', justifyContent: 'center', alignItems: 'center' }}>
          <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>01</Text>
        </Box>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E293B', marginTop: 14, lineHeight: 1.3 }}>安装</Text>
        <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5, marginTop: 10 }}>拖进「应用程序」/ 双击 exe</Text>
      </Box>
      <Box style={{ width: 36, height: 40, justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 28, color: '#94A3B8' }}>›</Text></Box>

      <Box style={{ width: 162, height: 220, background: '#F8FAFC', borderRadius: 8, border: '1px solid #E2E8F0', padding: 16, flexDirection: 'column' }}>
        <Box style={{ width: 28, height: 28, borderRadius: 8, background: '#2563EB', justifyContent: 'center', alignItems: 'center' }}>
          <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>02</Text>
        </Box>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E293B', marginTop: 14, lineHeight: 1.3 }}>登录</Text>
        <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5, marginTop: 10 }}>账号加密码，服务器不用改</Text>
      </Box>
      <Box style={{ width: 36, height: 40, justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 28, color: '#94A3B8' }}>›</Text></Box>

      <Box style={{ width: 162, height: 220, background: '#F8FAFC', borderRadius: 8, border: '1px solid #E2E8F0', padding: 16, flexDirection: 'column' }}>
        <Box style={{ width: 28, height: 28, borderRadius: 8, background: '#2563EB', justifyContent: 'center', alignItems: 'center' }}>
          <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>03</Text>
        </Box>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E293B', marginTop: 14, lineHeight: 1.3 }}>提问</Text>
        <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5, marginTop: 10 }}>Enter 发送，翻遍能看的库</Text>
      </Box>
      <Box style={{ width: 36, height: 40, justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 28, color: '#94A3B8' }}>›</Text></Box>

      <Box style={{ width: 162, height: 220, background: '#F8FAFC', borderRadius: 8, border: '1px solid #E2E8F0', padding: 16, flexDirection: 'column' }}>
        <Box style={{ width: 28, height: 28, borderRadius: 8, background: '#2563EB', justifyContent: 'center', alignItems: 'center' }}>
          <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>04</Text>
        </Box>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E293B', marginTop: 14, lineHeight: 1.3 }}>暂存</Text>
        <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5, marginTop: 10 }}>拖进来 / 选文件 / 写文字</Text>
      </Box>
      <Box style={{ width: 36, height: 40, justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 28, color: '#94A3B8' }}>›</Text></Box>

      <Box style={{ width: 162, height: 220, background: '#EFF6FF', borderRadius: 8, border: '2px solid #2563EB', padding: 16, flexDirection: 'column' }}>
        <Box style={{ width: 28, height: 28, borderRadius: 8, background: '#F59E0B', justifyContent: 'center', alignItems: 'center' }}>
          <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>05</Text>
        </Box>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E293B', marginTop: 14, lineHeight: 1.3 }}>存入</Text>
        <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5, marginTop: 10 }}>点「存入」才真正上传</Text>
      </Box>
      <Box style={{ width: 36, height: 40, justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 28, color: '#94A3B8' }}>›</Text></Box>

      <Box style={{ width: 162, height: 220, background: '#F8FAFC', borderRadius: 8, border: '1px solid #E2E8F0', padding: 16, flexDirection: 'column' }}>
        <Box style={{ width: 28, height: 28, borderRadius: 8, background: '#2563EB', justifyContent: 'center', alignItems: 'center' }}>
          <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>06</Text>
        </Box>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E293B', marginTop: 14, lineHeight: 1.3 }}>看结果</Text>
        <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5, marginTop: 10 }}>队列变「已入库」才算好</Text>
      </Box>
    </Box>

    <Box style={{ height: 96, marginTop: 30, flexDirection: 'row', alignItems: 'center', background: '#1E293B', borderRadius: 8, padding: 22 }}>
      <Box style={{ width: 6, height: 52, background: '#F59E0B', borderRadius: 8 }} />
      <Box style={{ marginLeft: 22, flexDirection: 'column' }}>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.3 }}>最容易漏的是第 05 步</Text>
        <Text style={{ fontSize: 18, color: '#CBD5E1', lineHeight: 1.5, marginTop: 6 }}>拖进来只是暂存，不点「存入」什么都不会上传</Text>
      </Box>
    </Box>

    <Box style={{ height: 121, marginTop: 30, flexDirection: 'column' }}>
      <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', gap: 16, borderBottom: '1px solid #E2E8F0' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#2563EB', width: 180 }}>收起不等于退出</Text>
        <Text style={{ fontSize: 18, color: '#475569' }}>× 只是隐藏面板；彻底结束要用 ⋯ → 退出应用</Text>
      </Box>
      <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', gap: 16, borderBottom: '1px solid #E2E8F0' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#2563EB', width: 180 }}>账号调整之后</Text>
        <Text style={{ fontSize: 18, color: '#475569' }}>完全退出应用 → 重新打开 → 重新登录，否则上传会 403</Text>
      </Box>
      <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', gap: 16 }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#2563EB', width: 180 }}>想查新版本</Text>
        <Text style={{ fontSize: 18, color: '#475569' }}>侧栏左下「检查更新」；macOS 必须装在「应用程序」</Text>
      </Box>
    </Box>
  </Box>

  <Box style={{ position: 'absolute', left: 0, right: 0, bottom: 30, padding: '0px 60px', flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#94A3B8' }}>知识小助 · 桌宠使用说明</Text>
    <Text style={{ fontSize: 14, color: '#94A3B8' }}>02 / 14</Text>
  </Box>
</Slide>
