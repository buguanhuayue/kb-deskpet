+
+// resolveRerankModelIDForQA 为普通知识问答挑一个重排模型。
+//
+// 这条链路原先从不设置 RerankModelID，rerank 阶段于是每次都
+// skip("empty_model_id")，引用顺序完全由向量原始分决定——2026-11-17 排查
+// 「引用全错」时，日志里 39 次请求全是这个 skip。检索 API
+// （HybridSearchWithRerank）和 agent 链路都会解析重排模型，只有最常用的
+// 问答入口漏了。
+//
+// 顺序：agent 自己配的 > 租户 RetrievalConfig > 工作区内置/默认 rerank 模型。
+// 都没有就返回空串，pipeline 退回检索顺序，与修复前行为一致，不会因为
+// 少了模型而报错。
+func (s *sessionService) resolveRerankModelIDForQA(ctx context.Context, req *types.QARequest) string {
+	if req != nil && req.CustomAgent != nil {
+		if id := strings.TrimSpace(req.CustomAgent.Config.RerankModelID); id != "" {
+			return id
+		}
+	}
+	var rc *types.RetrievalConfig
+	if info, ok := types.TenantInfoFromContext(ctx); ok && info != nil {
+		rc = info.RetrievalConfig
+	}
+	modelID, source, err := resolveRerankModelID(ctx, s.modelService, "", rc)
+	if err != nil {
+		logger.Warnf(ctx, "Resolve rerank model for knowledge QA failed: %v", err)
+		return ""
+	}
+	if modelID == "" {
+		logger.Infof(ctx, "No rerank model in this workspace, knowledge QA keeps retrieval order")
+		return ""
+	}
+	logger.Infof(ctx, "Knowledge QA rerank model: %s (source=%s)", modelID, source)
+	return modelID
+}
