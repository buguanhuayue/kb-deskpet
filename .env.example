# ---------- 数据库 ----------
POSTGRES_PASSWORD=change_me_pg_pass
DATABASE_URL=postgresql://kb:change_me_pg_pass@postgres:5432/kb

# ---------- 生成（Agnes / OpenAI 兼容）----------
LLM_BASE=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-3.0-flash
LLM_API_KEY=

# ---------- 向量化（必须 1024 维）----------
# 默认硅基流动；换阿里云百炼只改这 4 行
EMBED_BASE=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=
EMBED_DIM=1024
# 向量化不可用（余额不足/服务挂了）时：true=整篇置 failed；false=无向量入库，仅关键词可检索
EMBED_REQUIRED=true

# ---------- 重排（可空，空则只用 RRF 分数）----------
RERANK_BASE=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=

# ---------- 检索参数 ----------
TOP_K=5
CANDIDATES=40
RRF_K=60
NOT_FOUND_THRESHOLD=0.35

# ---------- 存储 ----------
STORAGE_DIR=/data/files
MAX_UPLOAD_MB=200

# ---------- 服务 ----------
APP_PORT=9527
LOG_LEVEL=INFO
