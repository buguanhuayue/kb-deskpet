# ---------- 数据库 ----------
POSTGRES_PASSWORD=change_me_pg_pass
DATABASE_URL=postgresql://kb:change_me_pg_pass@postgres:5432/kb

# ---------- 生成（Agnes / OpenAI 兼容）----------
LLM_BASE=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-3.0-flash
LLM_API_KEY=

# ---------- 向量化（必须 1024 维）----------
# 两种用法，改这 4 行即可切换：
#   A) 本机容器（compose 里的 embed 服务，免费、不花钱、权重落 models 卷）—— 推荐
#        EMBED_BASE=http://embed:8088/v1
#        EMBED_MODEL=jinaai/jina-embeddings-v3
#        EMBED_API_KEY=local          # 本地服务只校验非空
#   B) 云端（硅基流动 / 阿里云百炼 / 智谱…）
#        EMBED_BASE=https://api.siliconflow.cn/v1
#        EMBED_MODEL=BAAI/bge-m3
#        EMBED_API_KEY=sk-xxx
#
# 注意：本地 embed 服务用 fastembed 加载模型，**不支持 BAAI/bge-m3**
# （fastembed 0.7.x 已移除该模型）。方案 A 必须用 jina-embeddings-v3，
# 它同样是 1024 维，与数据库列定义一致，切换供应商不用重跑存量数据。
EMBED_BASE=http://embed:8088/v1
EMBED_MODEL=jinaai/jina-embeddings-v3
EMBED_API_KEY=local
EMBED_DIM=1024
# 向量化不可用（余额不足/服务挂了）时：true=整篇置 failed；false=无向量入库，仅关键词可检索
# 注意 false 仅用于联调：此时拒答闸门失效，不可用于生产
EMBED_REQUIRED=true

# ---------- 重排（可空，空则只用 RRF/余弦分数）----------
# 本地重排同样由 embed 服务提供；模型加载失败会返回 501，链路自动降级
RERANK_BASE=http://embed:8088/v1
RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
RERANK_API_KEY=local

# embed 容器实际加载的重排模型（与上面 RERANK_MODEL 保持一致）
LOCAL_RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual

# ---------- 检索参数 ----------
TOP_K=5
CANDIDATES=40
RRF_K=60
NOT_FOUND_THRESHOLD=0.35

# ---------- 存储 ----------
STORAGE_DIR=/data/files
MAX_UPLOAD_MB=200

# ---------- 服务 ----------
APP_PORT=9527
LOG_LEVEL=INFO
