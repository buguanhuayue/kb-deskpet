# 本地 embedding / rerank 服务镜像
# 不依赖 ghcr.io（这台机器拉不到），只用 PyPI + hf-mirror
FROM python:3.12-slim

ENV LANG=C.UTF-8 \
    PYTHONUTF8=1 \
    PYTHONUNBUFFERED=1 \
    HF_ENDPOINT=https://hf-mirror.com \
    FASTEMBED_CACHE_PATH=/models \
    OMP_NUM_THREADS=4

RUN apt-get update && apt-get install -y --no-install-recommends curl \
      && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 国内 PyPI 镜像；失败回落官方源
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple \
      "fastembed>=0.4,<0.8" "fastapi>=0.115" "uvicorn[standard]>=0.30" \
    || pip install --no-cache-dir \
      "fastembed>=0.4,<0.8" "fastapi>=0.115" "uvicorn[standard]>=0.30"

COPY embed_service ./embed_service

EXPOSE 8088
CMD ["uvicorn", "embed_service.app:app", "--host", "0.0.0.0", "--port", "8088"]
